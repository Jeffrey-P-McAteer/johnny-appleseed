// ---------------------------------------------------------------------------
//  MAIN MENU LAYOUT   (JSONC - // and /* */ comments and trailing commas are OK)
//
//  Artists place the menu's buttons over the backdrop art here; no C# needed.
//
//    backdrop   art-SET key (no extension / no weather-season tags). The game
//               picks the best-fitting edition at runtime from the files under
//               graphics/main-menu/ - e.g. backdrop.jpg (default), backdrop.rainy.png,
//               backdrop.fall.png, backdrop.winter.snowy.gif. See
//               scripts/media-variants-report.py for which editions exist.
//
//    buttons[]  each button:
//       id        stable identifier (for your reference)
//       label     text drawn on the button; some are overridden at runtime
//                 (play -> CONTINUE when a save is resumable; toggleFullscreen ->
//                 WINDOWED when already fullscreen)
//       x, y      button CENTER as a fraction of the screen (0..1), so the layout
//                 scales with any window size / fullscreen
//       width     optional plate width as a fraction of screen; omit to auto-size
//       fontSize  optional px size; omit for the default
//       action    "play" | "toggleFullscreen" | "exit"
//
//  Navigation: Up/Down/Left/Right (keyboard or controller) move focus to the
//  nearest button in that direction, so you can lay buttons out freely - a column,
//  a row, or scattered across the art.
// ---------------------------------------------------------------------------
{
  "backdrop": "graphics/main-menu/backdrop",
  "buttons": [
    { "id": "play",       "label": "PLAY",       "x": 0.5, "y": 0.60, "action": "play" },
    { "id": "fullscreen", "label": "FULLSCREEN", "x": 0.5, "y": 0.72, "action": "toggleFullscreen" },
    { "id": "exit",       "label": "EXIT",       "x": 0.5, "y": 0.84, "action": "exit" },
  ]
}
